---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Props = {
  HeroComponent?: any;
  heroImage?: ImageMetadata;
  heroAlt?: string;
};

const { HeroComponent, heroImage, heroAlt } = Astro.props;
---

{
  (HeroComponent || heroImage) && (
    <div class="mx-auto w-full max-w-5xl">
      {HeroComponent ? (
        <HeroComponent>
          {heroImage && (
            <Image
              alt={heroAlt ?? ""}
              class="mx-auto block rounded-xl"
              height={510}
              src={heroImage}
              width={1020}
              quality="high"
            />
          )}
        </HeroComponent>
      ) : (
        <Image
          alt={heroAlt ?? ""}
          class="mx-auto block rounded-xl"
          height={510}
          src={heroImage!}
          width={1020}
          quality="high"
        />
      )}
    </div>
  )
}
