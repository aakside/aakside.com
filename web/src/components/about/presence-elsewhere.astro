---
import type { ImageMetadata } from "astro";
import type { SvgComponent } from "astro/types";
import { Image } from "astro:assets";
import AnitaIcon from "../../assets/external-links/anita.png";
import DeviantArtIcon from "../../assets/external-links/deviantart.svg";
import GitHubIcon from "../../assets/external-links/github.svg";
import ListenBrainzIcon from "../../assets/external-links/listenbrainz.svg";
import MastodonIcon from "../../assets/external-links/mastodon.svg";
import PatreonIcon from "../../assets/external-links/patreon.svg";
import SoundCloudIcon from "../../assets/external-links/soundcloud.svg";
import StackExchangeIcon from "../../assets/external-links/stackexchange.svg";
import WikipediaIcon from "../../assets/external-links/wikipedia.svg";
import YouTubeIcon from "../../assets/external-links/youtube.svg";

type Link = {
  href: string;
  image: Partial<SvgComponent> & ImageMetadata;
  label: string;
};

const links: Link[] = [
  {
    href: "https://anitasunshine.com/",
    image: AnitaIcon,
    label: "My wife's heart",
  },
  {
    href: "https://mastodon.social/@aakside",
    image: MastodonIcon,
    label: "Mastodon",
  },
  {
    href: "https://www.youtube.com/aakside",
    image: YouTubeIcon,
    label: "YouTube",
  },
  {
    href: "https://listenbrainz.org/user/aakside/",
    image: ListenBrainzIcon,
    label: "ListenBrainz",
  },
  {
    href: "https://github.com/aakside/",
    image: GitHubIcon,
    label: "GitHub",
  },
  {
    href: "https://en.wikipedia.org/wiki/User:AAK",
    image: WikipediaIcon,
    label: "Wikipedia",
  },
  {
    href: "https://www.deviantart.com/aakside",
    image: DeviantArtIcon,
    label: "DeviantArt",
  },
  {
    href: "https://www.patreon.com/aakside",
    image: PatreonIcon,
    label: "Patreon",
  },
  {
    href: "https://stackexchange.com/users/1021716/aakside?tab=accounts",
    image: StackExchangeIcon,
    label: "StackExchange",
  },
  {
    href: "https://soundcloud.com/aakside",
    image: SoundCloudIcon,
    label: "SoundCloud",
  },
];
---

<ul>
  {
    links
      .toSorted((a, b) => a.label.localeCompare(b.label))
      .map((link) => (
        <li>
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.label}
            class="flex h-full flex-row items-center gap-4"
          >
            <span class="inline-flex aspect-square h-full items-center justify-center">
              <Image
                src={link.image}
                alt={`${link.label} icon`}
                class="aspect-square w-full object-contain"
              />
            </span>
            <span>{link.label}</span>
          </a>
        </li>
      ))
  }
</ul>
