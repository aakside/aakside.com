---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import SearchBox from "./SearchBox.astro";
import SearchModal from "./SearchModal.astro";
---

<header class="bg-base-200 overflow-visible px-4 shadow-[0_2px_8px_var(--color-base-300)]">
  <nav class="flex items-center justify-between gap-2 overflow-visible">
    <div class="m-0 text-2xl"><a class="px-2 py-4 no-underline" href="/">{SITE_TITLE}</a></div>
    <div class="internal-links [&_a.active]:text-accent space-x-1">
      <HeaderLink href="/about/">About</HeaderLink>
      <HeaderLink href="/blog/">Blog</HeaderLink>
      <HeaderLink href="/projects/">Projects</HeaderLink>
      {
        // The desktop <pagefind-searchbox> already claims the keyboard shortcut. There is no "no shortcut" option, so `shortcut="+"` gets split on `+` into empty parts, giving a binding whose key is `""`. It also keeps the derived `aria-keyshortcuts` empty (ARIA reads that as undefined).
      }
      <div class="ml-2 flex md:hidden">
        <pagefind-modal-trigger instance="modal" compact shortcut="+" hide-shortcut
        ></pagefind-modal-trigger>
      </div>
    </div>
    <div
      class="hidden md:relative md:flex md:min-w-[16rem] md:items-center md:justify-end lg:min-w-88"
    >
      <SearchBox instance="desktop" />
    </div>
  </nav>

  <SearchModal instance="modal" />
</header>
<style>
  @reference "tailwindcss";

  header {
    @apply m-0 py-1;
  }

  nav .internal-links {
    @apply flex flex-wrap items-center;
  }

  nav .internal-links a {
    @apply px-1 py-0 pt-1 text-lg no-underline;
  }

  nav .internal-links a.active {
    @apply border-current;
  }

  @media (max-width: 720px) {
    nav .internal-links a {
      padding-inline: 0.35rem;
    }
  }
</style>
