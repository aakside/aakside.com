---
import "../styles/global.css";
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import FallbackImage from "../assets/blog/placeholder-hero.svg";
import { SITE_TITLE } from "../consts";

interface Props {
  description: string;
  favicon?: string;
  heroAlt?: string;
  image?: ImageMetadata;
  modifiedDate?: Date;
  publishedDate?: Date;
  sectionTitle?: string;
  title?: string;
  type?: "article" | "website";
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  description,
  favicon = "/favicon.svg",
  heroAlt,
  image = FallbackImage,
  modifiedDate,
  publishedDate,
  sectionTitle,
  title,
  type = "website",
} = Astro.props;

const pageTitle = title ?? `${sectionTitle} - ${SITE_TITLE}`;

// Search results show the hero as a 64x48 thumbnail, so index a variant sized 2x of that for high-density displays.
const searchThumbnail = Astro.props.image
  ? await getImage({
      src: Astro.props.image,
      width: 128,
      height: 96,
      fit: "cover",
      format: "webp",
    })
  : undefined;

// Link-preview scrapers (Signal, iMessage, Slack, Facebook, X...) will not render an SVG, and they give up on images that are slow to fetch. Rasterise/rescale. Requires `image.dangerouslyProcessSVG` (astro.config.mjs).
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;
const ogImage = await getImage({
  src: image,
  width: OG_IMAGE_WIDTH,
  height: OG_IMAGE_HEIGHT,
  fit: "cover",
  format: "jpeg",
});
const ogCoverScale = Math.max(OG_IMAGE_WIDTH / image.width, OG_IMAGE_HEIGHT / image.height);
const ogImageWidth = ogCoverScale >= 1 ? image.width : OG_IMAGE_WIDTH;
const ogImageHeight = ogCoverScale >= 1 ? image.height : OG_IMAGE_HEIGHT;
const ogImageURL = new URL(ogImage.src, Astro.site);
const ogImageAlt = heroAlt ?? pageTitle;

const CONTENT_SECURITY_POLICY = [
  "script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  "worker-src 'self' blob:",
  "object-src 'none'",
  "base-uri 'self'",
].join("; ");

function getFaviconType(path: string) {
  const extension = path.match(/\.([a-z0-9]+)(?:[?#].*)?$/i)?.[1]?.toLowerCase();

  switch (extension) {
    case "png":
      return "image/png";
    case "ico":
      return "image/x-icon";
    case "jpg":
    case "jpeg":
      return "image/jpeg";
    case "webp":
      return "image/webp";
    default:
      return "image/svg+xml";
  }
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta http-equiv="Content-Security-Policy" content={CONTENT_SECURITY_POLICY} />
<link rel="icon" type={getFaviconType(favicon)} href={favicon} />
<link rel="stylesheet" href="/maplibre-gl.css" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<script src="../scripts/localize-dates.ts"></script>

<!-- Font preloads -->
<Font cssVariable="--font-myriad-pro" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{pageTitle}</title>
<meta name="title" content={title} data-pagefind-meta="title[content]" />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
{
  type === "article" && publishedDate && (
    <meta property="article:published_time" content={publishedDate.toISOString()} />
  )
}
{
  type === "article" && modifiedDate && (
    <meta property="article:modified_time" content={modifiedDate.toISOString()} />
  )
}

{/* Twitter's tags are `name`, not `property` — the OG namespace does not cover them. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Pagefind-specific Metadata -->
<meta data-pagefind-meta="title[content]" content={sectionTitle ?? title} />
{searchThumbnail && <meta data-pagefind-meta="image[content]" content={searchThumbnail.src} />}
{heroAlt && <meta data-pagefind-meta="image_alt[content]" content={heroAlt} />}
