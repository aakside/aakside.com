---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"professionalExperience">["data"];

const { description, endDate, startDate, title } = Astro.props;
const pageDescription =
  `Alvin Ali Khaled's experience at ${title}` + (description ? `: as a ${description}.` : ".");
---

<html lang="en" data-theme="aakside-blue">
  <head>
    <BaseHead title={title} description={pageDescription} />
    <meta name="theme-color" content="steelblue" />
    <script src="../scripts/theme-color.ts"></script>
    <style>
      @reference "tailwindcss";

      main {
        width: calc(100% - 1em);
        max-width: 100%;
        margin: 0 auto;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <div class="prose">
          <div class="title mb-0 leading-none">
            <h1 class="mx-0 mb-0.5">{title}</h1>
            <div class="mb-7 flex flex-col">
              <div>
                {description} from <FormattedDate date={startDate} format="date" />{
                  endDate ? (
                    <>
                      {" "}
                      to <FormattedDate date={endDate} format="date" />.
                    </>
                  ) : (
                    "."
                  )
                }
              </div>
            </div>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
  </body>
</html>
