---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { theme as defaultTheme, themes } from "virtual:theme";

type Props = CollectionEntry<"projects">["data"];

const DEFAULT_THEME_COLOR_PROPERTY = "--color-base-200";

const { title, seoTitle, description, favicon, pubDate, updatedDate, heroAlt, heroImage } =
  Astro.props;
const { hideScrollbar = false, minimalLayout = false, theme, themeColorProperty } = Astro.props;

const scrollbarClasses = hideScrollbar
  ? "[scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  : undefined;

let themeColor: string | undefined;
if (theme || themeColorProperty) {
  const projectTheme = theme ? themes[theme] : defaultTheme;
  if (!projectTheme) {
    throw new Error(`Project "${title}" sets unknown theme "${theme}" (see global.css).`);
  }

  const property = themeColorProperty ?? DEFAULT_THEME_COLOR_PROPERTY;
  themeColor = projectTheme[property];
  if (!themeColor) {
    throw new Error(
      `Project "${title}" sets themeColorProperty "${property}", which theme "${theme ?? "the site default"}" does not define (see global.css).`,
    );
  }
}
---

<html lang="en" data-theme="aakside-blue" class={scrollbarClasses}>
  <head>
    <BaseHead
      description={description}
      favicon={favicon}
      heroAlt={heroAlt}
      image={heroImage}
      pagefindTitle={title}
      themeColor={themeColor}
      title={seoTitle ?? title}
    />
  </head>

  <body class={scrollbarClasses}>
    {
      !minimalLayout && (
        <>
          <div class="hero-image">
            {heroImage && <Image alt={heroAlt!} height={510} src={heroImage} width={1020} />}
          </div>
          <div class="title">
            <h1>{title}</h1>
            <div class="date">
              <FormattedDate date={pubDate} />
              {updatedDate && (
                <div class="last-updated-on">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )}
            </div>
            <hr />
          </div>
        </>
      )
    }
    <slot />
  </body>
</html>
