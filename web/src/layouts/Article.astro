---
import { RotateCcwClock } from "@lucide/astro";
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import { GITHUB_REPO_URL } from "../consts";
import { theme } from "virtual:theme";

type Heading = {
  depth: number;
  slug: string;
  text: string;
};

export type Props = {
  description: string;
  favicon?: string;
  heroAlt?: string;
  heroComponent?: string;
  heroImage?: ImageMetadata;
  headings?: Heading[];
  latestCommitDiffUrl?: string;
  pubDate: Date;
  sourcePath?: string;
  title: string;
  updatedDate?: Date;
};

const {
  description,
  favicon,
  headings = [],
  heroAlt,
  heroComponent,
  heroImage,
  latestCommitDiffUrl,
  pubDate,
  sourcePath,
  title,
  updatedDate,
} = Astro.props;

const id = title.toLowerCase().replace(/\s+/g, "-");
const historyUrl = sourcePath ? `${GITHUB_REPO_URL}/commits/HEAD/${sourcePath}` : undefined;
const tocHeadings = headings.filter(
  (heading) => heading.depth >= 2 && heading.text.toLowerCase() !== "toc",
);

const blogComponentModules = import.meta.glob("../components/blog/**/*.astro", {
  eager: true,
}) as Record<string, { default: any }>;

const heroComponentPath = heroComponent ? `../components/blog/${id}/${heroComponent}` : undefined;

const HeroComponent = heroComponentPath
  ? blogComponentModules[heroComponentPath]?.default
  : undefined;

const themeColor = theme["--color-base-200"];

function getTocItemClass(depth: number) {
  if (depth <= 2) return "my-1";
  if (depth === 3) return "my-1 ml-3";
  return "my-1 ml-6";
}
---

<html lang="en" data-theme="aakside-blue">
  <head>
    <BaseHead
      title={title}
      description={description}
      favicon={favicon}
      heroAlt={heroAlt}
      image={heroImage}
      type="article"
      publishedDate={pubDate}
      modifiedDate={updatedDate}
    />
    <meta name="theme-color" content={themeColor} />
    <style>
      @reference "tailwindcss";

      main {
        width: calc(100% - 1em);
        max-width: 100%;
        margin: 0 auto;
      }

      :global(iframe) {
        @apply rounded-xl;
        width: 100%;
      }

      :global(img, video) {
        @apply rounded-xl;
        max-width: 100%;
        height: auto;
      }

      :global(.maplibregl-canvas) {
        @apply rounded-xl;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <article>
        <HeroSection HeroComponent={HeroComponent} heroImage={heroImage} heroAlt={heroAlt} />
        <div
          class:list={[
            "w-full",
            {
              "xl:grid xl:grid-cols-[minmax(0,720px)_minmax(220px,280px)] xl:items-start xl:justify-center xl:gap-6":
                tocHeadings.length > 0,
            },
          ]}
        >
          <div class="prose">
            <div class="text-center leading-none">
              <h1 class="mx-0 mb-0.5">{title}</h1>
              <div class="flex flex-col items-center">
                <div>Published on <FormattedDate date={pubDate} format="datetime" /></div>
                {
                  updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
                    <div class="inline-flex items-baseline gap-1 leading-normal italic">
                      Updated on{" "}
                      {latestCommitDiffUrl ? (
                        <a href={latestCommitDiffUrl} rel="noopener noreferrer" target="_blank">
                          <FormattedDate date={updatedDate} format="datetime" />
                        </a>
                      ) : (
                        <FormattedDate date={updatedDate} format="datetime" />
                      )}
                      {historyUrl && (
                        <a
                          aria-label="View file history"
                          class="link link-hover ml-1 inline-flex items-center self-center"
                          href={historyUrl}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          <RotateCcwClock class="relative top-px size-[1em]" />
                        </a>
                      )}
                    </div>
                  )
                }
              </div>
            </div>
            <hr class="mt-7! mb-6!" />
            <slot />
          </div>
          {
            tocHeadings.length > 0 && (
              <aside
                class="border-base-300 bg-base-100 mt-5 hidden max-h-[calc(100vh-6rem)] overflow-auto rounded-xl border px-4 py-3 min-[1200px]:sticky min-[1200px]:top-5 xl:block"
                aria-label="Table of contents"
              >
                <h5 class="mb-2 text-base">On this page</h5>
                <ul class="m-0 list-none p-0">
                  {tocHeadings.map((heading) => (
                    <li class={getTocItemClass(heading.depth)}>
                      <a
                        class="text-base-content/70 hover:text-base-content no-underline transition-colors"
                        href={`#${heading.slug}`}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </aside>
            )
          }
        </div>
      </article>
    </main>
  </body>
</html>
