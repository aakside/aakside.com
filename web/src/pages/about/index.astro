---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION } from "../../consts";
import Timeline from "../../components/about/Timeline.astro";
import Interests from "../../components/about/Interests.mdx";
import PresenceElsewhere from "../../components/about/presence-elsewhere.astro";

const professionalExperience = (await getCollection("professionalExperience")).sort(
  (a, b) => b.data.sortDate.getTime() - a.data.sortDate.getTime(),
);
---

<!doctype html>
<html lang="en" data-theme="aakside-blue">
  <head>
    <BaseHead sectionTitle="About" description={SITE_DESCRIPTION} />
    <meta name="theme-color" content="steelblue" />
    <script src="../../scripts/theme-color.ts"></script>
  </head>
  <body>
    <Header />
    <div class="mx-auto my-4 flex w-full max-w-7xl flex-col gap-x-8 2xl:flex-row 2xl:items-start">
      <div class="prose pb-0! 2xl:mx-0! 2xl:my-0! 2xl:min-w-0 2xl:flex-1">
        <h1 class="mx-0 text-center">Re: Alvin</h1>
        <hr class="mt-7! mb-6!" />
        <p>
          I'm a New Yorker with software engineering experience spanning machine learning,
          distributed systems, and full-stack web development.
        </p><p>
          I've built machine learning pipelines, ad-serving infrastructure, and recommender systems
          at scale in programmatic advertising. As a founding engineer at two startups, I've built
          real-time data infrastructure for fintech and a distributed LLM inference platform with
          verifiable proof-of-work semantics. My technical range covers Rust, TypeScript, Python,
          and C++, from CUDA kernels and streaming data pipelines to GraphQL APIs and product-facing
          UIs.
        </p><p>
          Contact me if you're interested in working together: <a
            data-obfuscation="0"
            href="mailto:aakside@gmail.com">aakside@gmail.com</a
          >
        </p>
        <Interests />
      </div>
      <div
        class="prose py-0! 2xl:mt-10! 2xl:w-sm! 2xl:flex-none 2xl:[&_h2]:text-2xl! [&_h2:not(p+&):not(:first-child)]:mt-8!"
      >
        <h2>Professional Experience (Abridged)</h2>
        <div class="[&_.timeline-end]:mb-6!">
          <Timeline
            collection={professionalExperience}
            detailsUrlPrefix="/about/professional-experience/"
            eventDescriptionKey="role"
            startTimelineAtFirstEntry={true}
            endTimelineAtLastEntry={true}
          />
        </div>
        <h2>Presence Elsewhere</h2>
        <div
          class="[&_ul]:mt-2 [&_ul]:flex [&_ul]:list-none [&_ul]:flex-col [&_ul]:p-0 [&_ul>li]:h-10 [&_ul>li>a]:no-underline"
        >
          <PresenceElsewhere />
        </div>
      </div>
    </div>
  </body>
</html>
