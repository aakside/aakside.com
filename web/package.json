{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "build": "npm run sync:maplibre-css && npm run sync:content-git-meta && npm run sync:media && astro build",
    "dev": "npm run sync:maplibre-css && npm run sync:content-git-meta && npm run sync:media -- --local-fallback && astro dev",
    "format": "prettier --write .",
    "lint": "eslint 'src/**/*.{js,astro}'",
    "preview": "npm run sync:maplibre-css && astro preview",
    "sync:content-git-meta": "node scripts/generate-content-git-meta.mjs",
    "sync:maplibre-css": "node scripts/sync-maplibre-css.mjs",
    "sync:media": "node scripts/sync-media-to-r2.mjs"
  },
  "dependencies": {
    "@aakside/svelte-maplibre-stack": "^0.1.2",
    "@americana/maplibre-shield-generator": "^0.1.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@expressive-code/plugin-collapsible-sections": "^0.44.1",
    "@lucide/astro": "^1.30.0",
    "@lucide/svelte": "^1.30.0",
    "@neodrag/svelte": "^3.0.0-next.10",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "astro-pagefind": "^2.0.1",
    "daisyui": "^5.7.16",
    "es-toolkit": "^1.50.0",
    "geojson": "^0.5.0",
    "maplibre-gl": "^5.21.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.120.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
